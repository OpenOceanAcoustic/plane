# syntax=docker/dockerfile:1.7
FROM node:22.22.1-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH="/pnpm:$PATH" TURBO_TELEMETRY_DISABLED=1 CI=1 GOMAXPROCS=2
WORKDIR /app
RUN corepack enable
COPY . .
RUN --mount=type=cache,id=public-pnpm,target=/pnpm/store pnpm install --frozen-lockfile --store-dir=/pnpm/store
ARG PUBLIC_ORIGIN
ENV VITE_API_BASE_URL="" VITE_WEB_BASE_URL=$PUBLIC_ORIGIN VITE_ADMIN_BASE_URL=$PUBLIC_ORIGIN VITE_ADMIN_BASE_PATH=/god-mode VITE_SPACE_BASE_URL=$PUBLIC_ORIGIN VITE_SPACE_BASE_PATH=/spaces VITE_LIVE_BASE_URL=$PUBLIC_ORIGIN VITE_LIVE_BASE_PATH=/live VITE_ENABLE_SESSION_RECORDER=0
RUN pnpm turbo run build --filter=web --filter=admin --filter=space --filter=live --concurrency=1

FROM node:22.22.1-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
RUN chmod -R a-w /app
USER node

FROM runtime AS live
COPY --from=build /app/apps/live/dist ./apps/live/dist
COPY --from=build /app/apps/live/package.json ./apps/live/package.json
COPY --from=build /app/apps/live/node_modules ./apps/live/node_modules
EXPOSE 3000
CMD ["node", "apps/live/dist/start.mjs"]

FROM runtime AS space
COPY --from=build /app/apps/space/build ./apps/space/build
COPY --from=build /app/apps/space/node_modules ./apps/space/node_modules
WORKDIR /app/apps/space
EXPOSE 3000
CMD ["node", "node_modules/@react-router/serve/bin.js", "./build/server/index.js"]

FROM caddy:2.10.2-alpine AS proxy
RUN setcap -r /usr/bin/caddy && addgroup -g 10001 plane && adduser -D -u 10001 -G plane plane && mkdir -p /srv/web /srv/admin && chown -R plane:plane /data /config
COPY tools/lab/Caddyfile.public /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/build/client /srv/web
COPY --from=build /app/apps/admin/build/client /srv/admin
USER 10001:10001
