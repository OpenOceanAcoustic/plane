# Build official, pinned source because upstream public binary images are unavailable.
FROM golang:1.24.8-bookworm AS builder
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOFLAGS=-p=1
WORKDIR /src
RUN mkdir -p /out
RUN git init minio && cd minio && git remote add origin https://github.com/minio/minio.git && \
    git fetch --depth 1 origin 7aac2a2c5b7c882e68c1ce017d8256be2feea27f && git checkout FETCH_HEAD && \
    go build -trimpath -o /out/minio . && cp LICENSE /out/MINIO-LICENSE
RUN git init mc && cd mc && git remote add origin https://github.com/minio/mc.git && \
    git fetch --depth 1 origin 77f82e18b5401a65958f1619df6ebb994634bd88 && git checkout FETCH_HEAD && \
    go build -trimpath -o /out/mc . && cp LICENSE /out/MC-LICENSE
FROM debian:bookworm-slim
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/minio /out/mc /usr/local/bin/
COPY --from=builder /out/*-LICENSE /usr/share/licenses/minio/
EXPOSE 9000 9090
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9090"]
